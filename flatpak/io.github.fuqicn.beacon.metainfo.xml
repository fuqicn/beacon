<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.fuqicn.beacon</id>

  <name>Beacon</name>
  <summary>A cross-platform Minecraft launcher</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.fuqicn">
    <name>fuqicn</name>
  </developer>

  <description>
    <p>
      Beacon is a modern, cross-platform Minecraft launcher built with Qt 6.
      It supports the full Minecraft launch pipeline including version resolution,
      asset and library downloads, mod loader installation (Fabric, Forge, NeoForge),
      Microsoft account authentication, Java runtime management, and instance management
      with per-instance settings.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Full Minecraft launch pipeline (version resolution, asset/library download)</li>
      <li>Mod loader installation (Fabric, Forge, NeoForge)</li>
      <li>Microsoft account authentication (MSA)</li>
      <li>Mod / modpack search and download</li>
      <li>Java runtime management and auto-download</li>
      <li>Instance management with per-instance settings</li>
      <li>System-following theme / transparency settings</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.fuqicn.beacon.desktop</launchable>

  <url type="homepage">https://github.com/fuqicn/beacon</url>
  <url type="bugtracker">https://github.com/fuqicn/beacon/issues</url>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#91C8F0</color>
    <color type="primary" scheme_preference="dark">#378ECC</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.0" date="2026-08-11">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>
