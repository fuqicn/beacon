        <file alias="goldblock.png">../src/icons/instances/GoldBlock.png</file>
        <file alias="redstoneblock.png">../src/icons/instances/RedstoneBlock.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="play.svg">../src/icons/play.svg</file>
