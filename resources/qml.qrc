        <file alias="magnifying-glass.svg">../src/icons/magnifying-glass.svg</file>
        <file alias="coffee.svg">../src/icons/coffee.svg</file>
        <file alias="folder.svg">../src/icons/folder.svg</file>
        <file alias="file-lines.svg">../src/icons/file-lines.svg</file>
        <file alias="star.svg">../src/icons/star.svg</file>
        <file alias="check.svg">../src/icons/check.svg</file>
        <file alias="xmark.svg">../src/icons/xmark.svg</file>
        <file alias="sun.svg">../src/icons/sun.svg</file>
        <file alias="moon.svg">../src/icons/moon.svg</file>
