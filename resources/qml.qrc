        <file alias="components/DownloadDialog.qml">../src/qml/components/DownloadDialog.qml</file>
        <file alias="components/DownloadProgressButton.qml">../src/qml/components/DownloadProgressButton.qml</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="play.svg">../src/icons/play.svg</file>
